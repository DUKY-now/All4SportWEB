{% extends 'base.html.twig' %}

{% block title %}Détails de la Commande - All4Sport{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/commande.css') }}">
{% endblock %}

{% block body %}
<div class="container">
    <div class="details-header">
        <h1>📋 Détails de la Commande #{{ commande.id }}</h1>
        <a href="{{ path('app_gestion_commande') }}" class="btn-back">← Retour</a>
    </div>

    <div class="details-content">
        <!-- Informations de la commande -->
        <section class="section-info">
            <h2>Informations Générales</h2>
            <div class="info-grid">
                <div class="info-item">
                    <strong>Numéro de commande :</strong>
                    <span>{{ commande.numeroCommande }}</span>
                </div>
                <div class="info-item">
                    <strong>Date :</strong>
                    <span>{{ commande.dateCommande|date('d/m/Y H:i') }}</span>
                </div>
                <div class="info-item">
                    <strong>Statut :</strong>
                    <span class="statut statut-{{ commande.statut }}">{{ commande.statut|capitalize }}</span>
                </div>
                <div class="info-item">
                    <strong>Mode de livraison :</strong>
                    <span>{{ commande.modeLivraison }}</span>
                </div>
            </div>
        </section>

        <!-- Informations du client -->
        <section class="section-info">
            <h2>👤 Informations du Client</h2>
            <div class="info-grid">
                <div class="info-item">
                    <strong>Nom :</strong>
                    <span>{{ commande.client.nom }} {{ commande.client.prenom }}</span>
                </div>
                <div class="info-item">
                    <strong>Email :</strong>
                    <span>{{ commande.client.email }}</span>
                </div>
                <div class="info-item">
                    <strong>Téléphone :</strong>
                    <span>{{ commande.client.telephone ?? 'Non renseigné' }}</span>
                </div>
            </div>
        </section>

        <!-- Adresse de livraison -->
        <section class="section-info">
            <h2>📍 Adresse de Livraison</h2>
            <div class="address-box">
                <p>{{ commande.adresse.rue }}</p>
                <p>{{ commande.adresse.complement ?? '' }}</p>
                <p>{{ commande.adresse.codePostal }} {{ commande.adresse.ville }}</p>
                <p>{{ commande.adresse.pays }}</p>
            </div>
        </section>

        <!-- Produits de la commande -->
        <section class="section-products">
            <h2>📦 Produits Commandés</h2>
            {% if commande.composers|length > 0 %}
                <table class="table-products">
                    <thead>
                        <tr>
                            <th>Produit</th>
                            <th>Quantité</th>
                            <th>Prix Unitaire</th>
                            <th>Sous-total</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% set totalCommande = 0 %}
                        {% for composer in commande.composers %}
                            <tr>
                                <td>
                                    <strong>{{ composer.produit.nomProduit }}</strong>
                                    {% if composer.produit.description %}
                                        <br><small>{{ composer.produit.description|slice(0, 100) }}...</small>
                                    {% endif %}
                                </td>
                                <td class="text-center">{{ composer.quantite }}</td>
                                <td class="text-right">{{ composer.prixUnitaire|number_format(2, ',', ' ') }} €</td>
                                <td class="text-right">
                                    <strong>{{ composer.sousTotal|number_format(2, ',', ' ') }} €</strong>
                                </td>
                            </tr>
                            {% set totalCommande = totalCommande + composer.sousTotal|number_format(2) %}
                        {% endfor %}
                    </tbody>
                </table>
                <div class="total-box">
                    <h3>Total : <span>{{ totalCommande|number_format(2, ',', ' ') }} €</span></h3>
                </div>
            {% else %}
                <p class="no-products">Aucun produit dans cette commande.</p>
            {% endif %}
        </section>

        <!-- Actions -->
        <section class="section-actions">
            <h2>Actions</h2>
            <form method="post" action="{{ path('app_gestion_commande_status', {'id': commande.id}) }}" class="form-status">
                <input type="hidden" name="_token" value="{{ csrf_token('gestion_commande') }}">
                <div class="form-group">
                    <label for="status">Changer le statut :</label>
                    <select name="status" id="status">
                        <option value="en_attente" {% if commande.statut == 'en_attente' %}selected{% endif %}>En attente</option>
                        <option value="en_cours" {% if commande.statut == 'en_cours' %}selected{% endif %}>En cours</option>
                        <option value="terminee" {% if commande.statut == 'terminee' %}selected{% endif %}>Terminée</option>
                        <option value="annulee" {% if commande.statut == 'annulee' %}selected{% endif %}>Annulée</option>
                    </select>
                    <button type="submit" class="btn-update">✅ Mettre à jour</button>
                </div>
            </form>
        </section>
    </div>
</div>
{% endblock %}

