{% extends 'base.html.twig' %}

{% block title %}Gestion des Commandes - All4Sport{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/commande.css') }}">
{% endblock %}

{% block body %}
<div class="container">
    <h1>🛠️ Gestion des Commandes</h1>
    {% for flash in app.flashes('success') %}
        <div class="flash flash-success">✅ {{ flash }}</div>
    {% endfor %}
    <table class="table-gestion-commande">
        <thead>
            <tr>
                <th>ID</th>
                <th>Client</th>
                <th>Date</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for commande in commandes %}
            <tr>
                <td>{{ commande.id }}</td>
                <td>{{ commande.client.email }}</td>
                <td>{{ commande.dateCommande|date('d/m/Y H:i') }}</td>
                <td>
                    <span class="statut statut-{{ commande.statut }}">{{ commande.statut|capitalize }}</span>
                </td>
                <td>
                    <div class="action-buttons">
                        <a href="{{ path('app_gestion_commande_details', {'id': commande.id}) }}" class="btn-details">👁️ Voir détails</a>
                        <form method="post" action="{{ path('app_gestion_commande_status', {'id': commande.id}) }}" class="form-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('gestion_commande') }}">
                            <select name="status">
                                <option value="en_attente" {% if commande.statut == 'en_attente' %}selected{% endif %}>En attente</option>
                                <option value="en_cours" {% if commande.statut == 'en_cours' %}selected{% endif %}>En cours</option>
                                <option value="terminee" {% if commande.statut == 'terminee' %}selected{% endif %}>Terminée</option>
                                <option value="annulee" {% if commande.statut == 'annulee' %}selected{% endif %}>Annulée</option>
                            </select>
                            <button type="submit" class="btn-update">Mettre à jour</button>
                        </form>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5">Aucune commande à afficher.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
