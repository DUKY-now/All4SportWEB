<div class="panier-wrapper">
    <div class="panier-header">
        <h1 class="panier-title">🛒 Mon Panier</h1>
        <p class="panier-subtitle" id="panier-subtitle">
            {% if count > 0 %}
                {{ count }} article{{ count > 1 ? 's' : '' }} dans votre panier
            {% else %}
                Votre panier est vide
            {% endif %}
        </p>
    </div>

    <div id="toast-container"></div>

    {% for flash in app.flashes('success') %}
        <div class="flash flash-success">✅ {{ flash }}</div>
    {% endfor %}
    {% for flash in app.flashes('info') %}
        <div class="flash flash-info">ℹ️ {{ flash }}</div>
    {% endfor %}
    {% for flash in app.flashes('warning') %}
        <div class="flash flash-warning">⚠️ {{ flash }}</div>
    {% endfor %}
    {% for flash in app.flashes('danger') %}
        <div class="flash flash-danger">❌ {{ flash }}</div>
    {% endfor %}

    {% if items|length > 0 %}
    <div class="panier-grid" id="panier-grid">

        <div class="panier-items" id="panier-items">
            {% for item in items %}
            <div class="panier-item" id="item-{{ item.produit.id }}" data-produit-id="{{ item.produit.id }}" data-prix="{{ item.produit.prixVente }}">
                <div class="item-image">
                    {% set icons = {
                        'football': '⚽', 'basketball': '🏀', 'tennis': '🎾',
                        'running': '👟', 'yoga': '🧘', 'dumbbells': '🏋️',
                        'swim': '🏊', 'kettlebell': '💪', 'watch': '⌚', 'resistance': '🎯'
                    } %}
                    {% set icon = '🏆' %}
                    {% for key, emoji in icons %}
                        {% if key in item.produit.imageUrl|lower %}{% set icon = emoji %}{% endif %}
                    {% endfor %}
                    <span>{{ icon }}</span>
                </div>

                <div class="item-info">
                    <div class="item-category">
                        {% if item.produit.stocks|length > 0 %}{{ item.produit.stocks[0].rayon.nomRayon }}{% endif %}
                    </div>
                    <h3 class="item-name">{{ item.produit.nomProduit }}</h3>
                    <p class="item-desc">
                        {{ item.produit.description|length > 60 ? item.produit.description|slice(0,60) ~ '...' : item.produit.description }}
                    </p>
                    <div class="item-price-unit">{{ item.produit.prixVente }} € / unité</div>
                </div>

                <div class="item-controls">
                    <div class="qty-control">
                        <button type="button" class="qty-btn btn-decrease"
                                data-url="{{ path('app_panier_decrease', {'id': item.produit.id}) }}"
                                data-token="{{ csrf_token('panier') }}">−</button>
                        <span class="qty-value" id="qty-{{ item.produit.id }}">{{ item.quantite }}</span>
                        <button type="button" class="qty-btn btn-increase"
                                data-url="{{ path('app_panier_increase', {'id': item.produit.id}) }}"
                                data-token="{{ csrf_token('panier') }}">+</button>
                    </div>

                    <div class="item-sous-total" id="sous-total-{{ item.produit.id }}">{{ item.sousTotal }} €</div>

                    <button type="button" class="btn-remove btn-remove-ajax"
                            data-url="{{ path('app_panier_remove', {'id': item.produit.id}) }}"
                            data-token="{{ csrf_token('panier') }}"
                            title="Supprimer">🗑️</button>
                </div>
            </div>
            {% endfor %}

            <div class="panier-actions-bottom">
                <a href="{{ path('app_produit_index') }}" class="btn-continue">← Continuer mes achats</a>
                <form action="{{ path('app_panier_clear') }}" method="POST">
                    <input type="hidden" name="_token" value="{{ csrf_token('panier') }}">
                    <button type="submit" class="btn-clear">🗑️ Vider le panier</button>
                </form>
            </div>
        </div>

        <aside class="panier-summary">
            <h2 class="summary-title">Récapitulatif</h2>

            <div class="summary-lines" id="summary-lines">
                {% for item in items %}
                <div class="summary-line" id="summary-line-{{ item.produit.id }}">
                    <span class="summary-line-label">{{ item.produit.nomProduit }} × <span class="summary-qty">{{ item.quantite }}</span></span>
                    <span class="summary-line-price">{{ item.sousTotal }} €</span>
                </div>
                {% endfor %}
            </div>

            <div class="summary-separator"></div>

            <div class="summary-total">
                <span>Total</span>
                <span class="total-amount" id="total-amount">{{ total }} €</span>
            </div>

            <div class="summary-delivery">
                <span>🚚 Livraison</span>
                <span class="delivery-free">Gratuite</span>
            </div>

            {% if app.user %}
                <a href="{{ path('app_panier_checkout') }}" class="btn-checkout">
                    Passer la commande →
                </a>
            {% endif %}

            <div class="summary-secure">
                🔒 Paiement 100% sécurisé &nbsp;·&nbsp; Retour gratuit 30j
            </div>
        </aside>
    </div>

    {% else %}
    <div class="panier-empty" id="panier-empty">
        <div class="empty-icon">🛒</div>
        <h2>Votre panier est vide</h2>
        <p>Parcourez notre catalogue et ajoutez des produits à votre panier !</p>
        <a href="{{ path('app_produit_index') }}" class="btn-shop">Découvrir les produits</a>
    </div>
    {% endif %}
</div>

<footer class="footer">
    <div class="footer-container">
        <p class="footer-bottom">© 2026 All4Sport – Tous droits réservés</p>
    </div>
</footer>

<script>
// ===== PANIER AJAX =====

function showToast(msg, type = 'success') {
    const container = document.getElementById('toast-container');
    const toast = document.createElement('div');
    toast.className = 'toast toast-' + type;
    toast.textContent = msg;
    container.appendChild(toast);
    requestAnimationFrame(() => toast.classList.add('toast-visible'));
    setTimeout(() => {
        toast.classList.remove('toast-visible');
        setTimeout(() => toast.remove(), 300);
    }, 2500);
}

function updateGlobalCount(count) {
    // Met à jour le sous-titre
    const subtitle = document.getElementById('panier-subtitle');
    if (subtitle) {
        subtitle.textContent = count > 0
            ? count + ' article' + (count > 1 ? 's' : '') + ' dans votre panier'
            : 'Votre panier est vide';
    }
}

function updateTotal(total) {
    const el = document.getElementById('total-amount');
    if (el) el.textContent = parseFloat(total).toFixed(2) + ' €';
}

function removeItemFromDOM(produitId) {
    const item = document.getElementById('item-' + produitId);
    if (item) {
        item.style.transition = 'opacity 0.3s, transform 0.3s';
        item.style.opacity = '0';
        item.style.transform = 'translateX(30px)';
        setTimeout(() => item.remove(), 300);
    }
    const summaryLine = document.getElementById('summary-line-' + produitId);
    if (summaryLine) summaryLine.remove();
}

async function panierAjax(url, token, extraData = {}) {
    const body = new URLSearchParams({ _token: token, ...extraData });
    const resp = await fetch(url, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body.toString(),
    });
    return resp.json();
}

// Boutons + (augmenter)
document.querySelectorAll('.btn-increase').forEach(btn => {
    btn.addEventListener('click', async () => {
        btn.disabled = true;
        const row = btn.closest('.panier-item');
        const produitId = row.dataset.produitId;
        try {
            const data = await panierAjax(btn.dataset.url, btn.dataset.token);
            if (data.success) {
                document.getElementById('qty-' + produitId).textContent = data.quantite;
                document.getElementById('sous-total-' + produitId).textContent = parseFloat(data.sousTotal).toFixed(2) + ' €';
                // Mise à jour recap
                const summaryQty = document.querySelector('#summary-line-' + produitId + ' .summary-qty');
                const summaryPrice = document.querySelector('#summary-line-' + produitId + ' .summary-line-price');
                if (summaryQty) summaryQty.textContent = data.quantite;
                if (summaryPrice) summaryPrice.textContent = parseFloat(data.sousTotal).toFixed(2) + ' €';
                updateTotal(data.total);
                updateGlobalCount(data.count);
            }
        } catch(e) { showToast('Erreur réseau', 'danger'); }
        btn.disabled = false;
    });
});

// Boutons − (diminuer)
document.querySelectorAll('.btn-decrease').forEach(btn => {
    btn.addEventListener('click', async () => {
        btn.disabled = true;
        const row = btn.closest('.panier-item');
        const produitId = row.dataset.produitId;
        try {
            const data = await panierAjax(btn.dataset.url, btn.dataset.token);
            if (data.success) {
                if (data.removed) {
                    removeItemFromDOM(produitId);
                    showToast('Article retiré du panier', 'info');
                } else {
                    document.getElementById('qty-' + produitId).textContent = data.quantite;
                    document.getElementById('sous-total-' + produitId).textContent = parseFloat(data.sousTotal).toFixed(2) + ' €';
                    const summaryQty = document.querySelector('#summary-line-' + produitId + ' .summary-qty');
                    const summaryPrice = document.querySelector('#summary-line-' + produitId + ' .summary-line-price');
                    if (summaryQty) summaryQty.textContent = data.quantite;
                    if (summaryPrice) summaryPrice.textContent = parseFloat(data.sousTotal).toFixed(2) + ' €';
                }
                updateTotal(data.total);
                updateGlobalCount(data.count);
            }
        } catch(e) { showToast('Erreur réseau', 'danger'); }
        btn.disabled = false;
    });
});

// Boutons 🗑️ (supprimer)
document.querySelectorAll('.btn-remove-ajax').forEach(btn => {
    btn.addEventListener('click', async () => {
        const row = btn.closest('.panier-item');
        const produitId = row.dataset.produitId;
        try {
            const data = await panierAjax(btn.dataset.url, btn.dataset.token);
            if (data.success) {
                removeItemFromDOM(produitId);
                updateTotal(data.total);
                updateGlobalCount(data.count);
                showToast('Article retiré du panier', 'info');
                if (data.count === 0) {
                    setTimeout(() => location.reload(), 400);
                }
            }
        } catch(e) { showToast('Erreur réseau', 'danger'); }
    });
});
</script>
{% endblock %}
