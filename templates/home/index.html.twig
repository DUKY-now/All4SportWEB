{% extends 'base.html.twig' %}

{% block title %}Accueil - All4Sport{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/home.css') }}">
{% endblock %}

{% block body %}
<!-- Navigation -->
<nav class="navbar">
    <div class="nav-container">
        <div class="logo">🏃 All4Sport</div>
        <ul class="nav-menu">
            <li><a href="{{ path('app_home') }}" class="nav-link">Accueil</a></li>
            <li><a href="{{ path('app_produit_index') }}" class="nav-link">Produits</a></li>
            <li><a href="#" class="nav-link">À propos</a></li>
            {% if app.user %}
                <li><a href="{{ path('app_account') }}" class="nav-link">Mon compte</a></li>
                <li><a href="{{ path('app_panier_index') }}" class="nav-link">🛒 Panier</a></li>
                <li><a href="{{ path('app_logout') }}" class="btn-nav btn-outline">Déconnexion</a></li>
            {% else %}
                <li><a href="{{ path('app_panier_index') }}" class="nav-link">🛒 Panier</a></li>
                <li><a href="{{ path('app_login') }}" class="btn-nav btn-outline">Connexion</a></li>
                <li><a href="{{ path('app_register') }}" class="btn-nav">Inscription</a></li>
            {% endif %}
        </ul>
    </div>
</nav>

<!-- Hero Section -->
<section class="hero">
    <div class="hero-container">
        {% if app.user %}
            <h1>Bienvenue {{ app.user.prenom }} {{ app.user.nom }} ! 🎉</h1>
            <p>Découvrez nos derniers équipements sportifs et profitez de nos offres exclusives</p>
        {% else %}
            <h1>Votre boutique sport en ligne 🏆</h1>
            <p>Équipements de qualité pour tous les sports - Livraison rapide - Prix compétitifs</p>
        {% endif %}

        <div class="hero-buttons">
            <a href="{{ path('app_produit_index') }}" class="btn-hero primary">Voir les produits</a>
            {% if not app.user %}
                <a href="{{ path('app_register') }}" class="btn-hero secondary">Créer un compte</a>
            {% endif %}
        </div>
    </div>
</section>

<!-- User Info Section (si connecté) -->
{% if app.user %}
<div class="user-info" style="margin: 3rem auto; max-width: 1200px;">
    <h2>📋 Vos informations</h2>
    <div class="user-details">
        <div class="user-detail-item">
            <strong>👤 Nom complet</strong>
            <span>{{ app.user.prenom }} {{ app.user.nom }}</span>
        </div>
        <div class="user-detail-item">
            <strong>📧 Email</strong>
            <span>{{ app.user.email }}</span>
        </div>
        <div class="user-detail-item">
            <strong>📱 Téléphone</strong>
            <span>{{ app.user.telephone ?? 'Non renseigné' }}</span>
        </div>
        <div class="user-detail-item">
            <strong>📅 Membre depuis</strong>
            <span>{{ app.user.dateInscription|date('d/m/Y') }}</span>
        </div>
        <div class="user-detail-item">
            <strong>📍 Adresse</strong>
            <span>{{ app.user.adresse.rue }}, {{ app.user.adresse.codePostal }} {{ app.user.adresse.ville }}</span>
        </div>
        <div class="user-detail-item">
            <strong>🌍 Pays</strong>
            <span>{{ app.user.adresse.pays }}</span>
        </div>
    </div>
</div>
{% endif %}

<!-- Features Section -->
<section class="features">
    <div class="features-container">
        <h2 class="section-title">Pourquoi choisir All4Sport ?</h2>
        <p class="section-subtitle">Les meilleurs équipements pour atteindre vos objectifs</p>

        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">🚚</div>
                <h3>Livraison rapide</h3>
                <p>Recevez vos équipements en 24-48h partout en France</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">💯</div>
                <h3>Qualité garantie</h3>
                <p>Produits certifiés et testés par des professionnels</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">💰</div>
                <h3>Prix compétitifs</h3>
                <p>Les meilleurs prix du marché, promotions régulières</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">🔒</div>
                <h3>Paiement sécurisé</h3>
                <p>Transactions 100% sécurisées avec cryptage SSL</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">💬</div>
                <h3>Support client</h3>
                <p>Équipe disponible 7j/7 pour vous accompagner</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">🔄</div>
                <h3>Retour gratuit</h3>
                <p>30 jours pour changer d'avis, retour offert</p>
            </div>
        </div>
    </div>
</section>

<!-- Footer -->
<footer class="footer">
    <div class="footer-container">
        <div class="footer-content">
            <div class="footer-section">
                <h3>All4Sport</h3>
                <p>Votre partenaire sport depuis 2026</p>
            </div>

            <div class="footer-section">
                <h3>Navigation</h3>
                <ul>
                    <li><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li><a href="{{ path('app_produit_index') }}">Produits</a></li>
                    <li><a href="#">À propos</a></li>
                    <li><a href="#">Contact</a></li>
                </ul>
            </div>

            <div class="footer-section">
                <h3>Mon compte</h3>
                <ul>
                    {% if app.user %}
                        <li><a href="#">Mes commandes</a></li>
                        <li><a href="#">Mon profil</a></li>
                        <li><a href="{{ path('app_logout') }}">Déconnexion</a></li>
                    {% else %}
                        <li><a href="{{ path('app_login') }}">Connexion</a></li>
                        <li><a href="{{ path('app_register') }}">Inscription</a></li>
                    {% endif %}
                </ul>
            </div>

            <div class="footer-section">
                <h3>Informations</h3>
                <ul>
                    <li><a href="#">Mentions légales</a></li>
                    <li><a href="#">CGV</a></li>
                    <li><a href="#">Politique de confidentialité</a></li>
                    <li><a href="#">Livraison & Retours</a></li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; 2026 All4Sport - Tous droits réservés</p>
        </div>
    </div>
</footer>
{% endblock %}
